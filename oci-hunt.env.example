# Copy to ~/.config/oci-hunt.env, fill in, then chmod 600 (it holds a webhook).
# Get the OCIDs with:  ./oci-hunt.sh discover

# --- required ---------------------------------------------------------------
COMPARTMENT_ID=ocid1.tenancy.oc1..CHANGEME
SUBNET_ID=ocid1.subnet.oc1.REGION.CHANGEME     # must be a PUBLIC subnet
IMAGE_ID=ocid1.image.oc1.REGION.CHANGEME       # aarch64 image for A1.Flex

# The .pub, not the private key. Exactly one key, no trailing blank line.
SSH_KEY=/home/YOURUSER/.ssh/oci.pub

# --- shape ------------------------------------------------------------------
SHAPE=VM.Standard.A1.Flex
OCPUS=1          # 1/6 lands far more often than 4/24, and A1.Flex can be
MEM_GB=6         # resized later, so take the small one and grow it
DISPLAY_NAME=free-instance

# --- pacing -----------------------------------------------------------------
# 0 means hunt until it lands. Safe to leave at 0: the script checks whether an
# instance already exists before every run and exits when it finds one.
MAX_TRIES=0

# How many attempts per day to sustain. The script times each launch call and
# sleeps the remainder, so the rate holds steady whether a capacity search
# takes one minute or four. This is the knob that matters.
#
#   ATTEMPTS_PER_DAY=130   an attempt every 11.1 min
#   ATTEMPTS_PER_DAY=160   every  9.0 min
#   ATTEMPTS_PER_DAY=80    every 18.0 min
#   ATTEMPTS_PER_DAY=0     fall back to the fixed MIN_SLEEP/MAX_SLEEP below
#
# Rate is not the main hazard. Oracle has flagged accounts and zeroed their
# service limits on CUMULATIVE volume, at intervals as gentle as ten minutes
# sustained over months -- see
# mohankumarpaluru/oracle-freetier-instance-creation#75. That case worked out
# at roughly 144 attempts/day. 130 sits just under it. Going higher is your
# call, but it is the number to be deliberate about.
#
# The change that actually improves your odds is upgrading the account to Pay
# As You Go: better capacity access, no idle reclamation, no trial expiry, and
# Always Free resources stay free. Prefer that over raising this number.
ATTEMPTS_PER_DAY=130

# Only used when ATTEMPTS_PER_DAY=0.
MIN_SLEEP=390
MAX_SLEEP=450

# Absolute floor between attempts, whatever the pacing computes.
PACE_FLOOR=60

# --- optional ---------------------------------------------------------------
# Hours between "still hunting" messages, so silence never means "it died".
# 0 turns them off.
HEARTBEAT_HOURS=12

# Auth errors are usually a stale token. Give up after this many in a row.
AUTH_RETRIES=10

DISCORD_WEBHOOK=
