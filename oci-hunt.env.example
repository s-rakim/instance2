# Copy to ~/.config/oci-hunt.env, fill in, then chmod 600 (it holds a webhook).
# Get the OCIDs with:  ./oci-hunt.sh discover

# --- required ---------------------------------------------------------------
COMPARTMENT_ID=ocid1.tenancy.oc1..CHANGEME
SUBNET_ID=ocid1.subnet.oc1.REGION.CHANGEME     # must be a PUBLIC subnet
IMAGE_ID=ocid1.image.oc1.REGION.CHANGEME       # aarch64 image for A1.Flex

# The .pub, not the private key. Exactly one key, no trailing blank line.
SSH_KEY=/home/YOURUSER/.ssh/oci.pub

# --- shape ------------------------------------------------------------------
SHAPE=VM.Standard.A1.Flex
OCPUS=1          # 1/6 lands far more often than 4/24, and A1.Flex can be
MEM_GB=6         # resized later, so take the small one and grow it
DISPLAY_NAME=free-instance

# --- pacing -----------------------------------------------------------------
# 0 means hunt until it lands. Safe to leave at 0: the script checks whether an
# instance already exists before every run and exits when it finds one.
MAX_TRIES=0

# Sleep between attempts. The launch call adds ~2 min on top, so these values
# put attempts about 8.9 minutes apart.
#
# Rate is NOT the main hazard. Accounts have been flagged on cumulative volume
# at intervals as gentle as 10 minutes, after months of running
# (mohankumarpaluru/oracle-freetier-instance-creation#75). Running 24/7 at the
# default is ~160 attempts/day, which is above that case. Choose knowingly:
#
#   MIN_SLEEP=390  MAX_SLEEP=450   ~160 attempts/day   (default)
#   MIN_SLEEP=840  MAX_SLEEP=960    ~80 attempts/day
#   MIN_SLEEP=1740 MAX_SLEEP=1860   ~45 attempts/day
#
# Upgrading the account to Pay As You Go reportedly both improves capacity
# access and avoids this risk, and Always Free resources stay free on PAYG.
MIN_SLEEP=390
MAX_SLEEP=450

# --- optional ---------------------------------------------------------------
# Hours between "still hunting" messages, so silence never means "it died".
# 0 turns them off.
HEARTBEAT_HOURS=12

# Auth errors are usually a stale token. Give up after this many in a row.
AUTH_RETRIES=10

DISCORD_WEBHOOK=
